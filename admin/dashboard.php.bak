<?php
include '../includes/db.php';

$students = mysqli_num_rows(mysqli_query($conn, "SELECT * FROM students"));
$attendance = mysqli_num_rows(mysqli_query($conn, "SELECT * FROM attendance"));
$paid = mysqli_num_rows(mysqli_query($conn, "SELECT * FROM students WHERE payment_status='Paid'"));
$unpaid = mysqli_num_rows(mysqli_query($conn, "SELECT * FROM students WHERE payment_status='Unpaid'"));
?>

