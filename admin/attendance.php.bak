<?php

include '../includes/db.php';

/* INDIA TIMEZONE */

date_default_timezone_set("Asia/Kolkata");

/* TODAY DATE */

$current_date = date('Y-m-d');

/* TOTAL STUDENTS */

$total_students = mysqli_num_rows(

mysqli_query($conn,
"SELECT * FROM students")

);

/* TODAY PRESENT */

$total_present = mysqli_num_rows(

mysqli_query($conn,

"SELECT * FROM attendance

WHERE attendance_date='$current_date'")

);

/* TODAY ABSENT */

$total_absent = $total_students - $total_present;

?>

<!DOCTYPE html>
<html>
<head>

<title>Daily Attendance</title>

<link rel="stylesheet"
href="../assets/css/style.css">

<style>

.present{

color:limegreen;

font-weight:bold;

font-size:18px;
}

.absent{

color:red;

font-weight:bold;

font-size:18px;
}

.summary{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(220px,1fr));

gap:20px;

margin-bottom:30px;
}

.summary-box{

background:
linear-gradient(
135deg,
#2563eb,
#1d4ed8
);

padding:25px;

border-radius:20px;

color:white;

text-align:center;
}

.summary-box h1{

font-size:40px;

margin-top:10px;
}

</style>

</head>

<body>

<?php include '../includes/header.php'; ?>

<div class="main">

<!-- TOPBAR -->

<div class="topbar">

<h1>📅 Daily Attendance Report</h1>

<button class="toggle-btn"
onclick="toggleMode()">

🌙 Dark / ☀ Light

</button>

</div>

<!-- SUMMARY -->

<div class="summary">

<div class="summary-box">

<h2>Total Students</h2>

<h1>
<?php echo $total_students; ?>
</h1>

</div>

<div class="summary-box">

<h2>Today Present</h2>

<h1>
<?php echo $total_present; ?>
</h1>

</div>

<div class="summary-box">

<h2>Today Absent</h2>

<h1>
<?php echo $total_absent; ?>
</h1>

</div>

</div>

<!-- TABLE -->

<div class="card">

<h2>
Today's Attendance
(
<?php echo $current_date; ?>
)
</h2>

<br>

<table>

<tr>

<th>ID</th>
<th>Student Name</th>
<th>Date</th>
<th>Time</th>
<th>Status</th>

</tr>

<?php

$students = mysqli_query($conn,

"SELECT * FROM students");

while($student=mysqli_fetch_assoc($students)){

$student_id = $student['id'];

/* TODAY ONLY */

$attendance = mysqli_query($conn,

"SELECT * FROM attendance

WHERE student_id='$student_id'

AND attendance_date='$current_date'");

if(mysqli_num_rows($attendance)>0){

$row = mysqli_fetch_assoc($attendance);

$status = "Present";

$time = $row['attendance_time'];

}else{

$status = "Absent";

$time = "--";
}

?>

<tr>

<td>
<?php echo $student['id']; ?>
</td>

<td>
<?php echo $student['username']; ?>
</td>

<td>
<?php echo $current_date; ?>
</td>

<td>
<?php echo $time; ?>
</td>

<td>

<?php

if($status=="Present"){

echo "<span class='present'>
✅ Present
</span>";

}else{

echo "<span class='absent'>
❌ Absent
</span>";
}

?>

</td>

</tr>

<?php } ?>

</table>

</div>

</div>

<script>

/* DARK MODE */

function toggleMode(){

document.body.classList.toggle('dark');

if(document.body.classList.contains('dark')){

localStorage.setItem('theme','dark');

}else{

localStorage.setItem('theme','light');

}

}

/* LOAD THEME */

if(localStorage.getItem('theme')==='dark'){

document.body.classList.add('dark');

}

</script>

</body>
</html>