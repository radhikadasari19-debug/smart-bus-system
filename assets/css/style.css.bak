*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

:root{
    --bg:#f1f5f9;
    --text:#111827;
    --card:#ffffff;
    --sidebar:#0f172a;
    --sidebarText:#ffffff;
    --primary:#2563eb;
}

body.dark{
    --bg:#020617;
    --text:#ffffff;
    --card:#111827;
    --sidebar:#000000;
    --sidebarText:#ffffff;
}

body{
    background:var(--bg);
    color:var(--text);
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    width:260px;
    height:100vh;
    background:var(--sidebar);
    position:fixed;
    left:0;
    top:0;
    padding:20px;
    overflow-y:auto;
}

.sidebar h2{
    color:#60a5fa;
    text-align:center;
    margin-bottom:30px;
    font-size:28px;
}

.sidebar a{
    display:block;
    color:var(--sidebarText);
    text-decoration:none;
    padding:14px 18px;
    margin-bottom:10px;
    border-radius:10px;
    transition:0.3s;
    font-size:17px;
}

.sidebar a:hover{
    background:var(--primary);
}

/* MAIN CONTENT */

.main{
    margin-left:260px;
    width:calc(100% - 260px);
    padding:30px;
}

/* TOPBAR */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
}

.toggle-btn{
    background:var(--primary);
    color:white;
    border:none;
    padding:10px 18px;
    border-radius:10px;
    cursor:pointer;
}

/* CARDS */

.card{
    background:var(--card);
    padding:25px;
    border-radius:20px;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
    margin-bottom:20px;
}

/* DASHBOARD BOXES */

.dashboard-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.dashboard-box{
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    color:white;
    padding:30px;
    border-radius:20px;
    text-align:center;
}

.dashboard-box h1{
    font-size:35px;
}

/* FORM */

input,
select,
button{
    width:100%;
    padding:12px;
    margin-top:12px;
    border-radius:10px;
    border:1px solid #d1d5db;
}

button{
    background:var(--primary);
    color:white;
    border:none;
    cursor:pointer;
}

/* TABLE */

table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
}

table th{
    background:var(--primary);
    color:white;
}

table th,
table td{
    padding:15px;
    text-align:center;
    border-bottom:1px solid #e5e7eb;
    background:var(--card);
}

/* FACE IMAGE */

img.face{
    width:70px;
    height:70px;
    border-radius:50%;
    object-fit:cover;
}

/* MOBILE RESPONSIVE */

@media(max-width:768px){

body{
    flex-direction:column;
}

.sidebar{
    width:100%;
    height:auto;
    position:relative;
}

.main{
    margin-left:0;
    width:100%;
}

.topbar{
    flex-direction:column;
    gap:15px;
}

}